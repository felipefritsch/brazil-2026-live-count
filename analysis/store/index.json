{"text": "<style>\n.lc { display: grid; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.lc-head h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0 0 var(--cds-gap-sm); text-wrap: balance; }\n.lc-take { font-size: var(--cds-font-size-body); color: var(--color-fg-muted); max-width: 70ch; margin: 0; line-height: 1.5; }\n.lc-take b, .lc-para b, .lc-figs b { font-weight: 600; color: var(--color-fg); font-variant-numeric: tabular-nums; }\n.lc-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--cds-gap-md); }\n.lc-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; }\n.lc-tile .k { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.lc-tile .v { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n.lc-tile .d { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.lc-sec { display: grid; gap: var(--cds-gap-md); }\n.lc-sec > h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.lc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n.lc-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-sm); align-content: start; min-width: 0; }\n.lc-card h3 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; text-wrap: balance; }\n.lc-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; max-width: 75ch; line-height: 1.5; }\n.lc-chart { position: relative; min-height: 260px; }\n.lc-chart svg text { font-size: var(--cds-font-size-caption); fill: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.lc-chart svg text.lbl { fill: var(--color-fg); }\n.lc-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs) var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); align-items: center; }\n.lc-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }\n.lc-legend .ramp { width: 96px; height: 10px; border-radius: 3px; margin: 0 6px; }\n.lc-seg { display: flex; flex-wrap: wrap; gap: var(--cds-gap-xs); }\n.lc-seg button { font: inherit; font-size: var(--cds-font-size-caption); border: 1px solid var(--color-border-line); background: transparent; color: var(--color-fg-muted); padding: 4px 10px; border-radius: var(--cds-radius); cursor: pointer; }\n.lc-seg button[aria-pressed=\"true\"] { background: var(--color-fg); color: var(--color-bg); border-color: var(--color-fg); }\n.lc-tablewrap { overflow-x: auto; }\n.lc table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.lc th, .lc td { padding: 6px 8px; text-align: right; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.lc th:first-child, .lc td:first-child { text-align: left; }\n.lc th { color: var(--color-fg-muted); font-weight: 500; }\n.lc-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; z-index: 5; max-width: 260px; }\n.lc-tip .t { color: var(--cds-text-secondary); margin-bottom: 2px; }\n.lc-final { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--cds-gap-lg); align-items: start; }\n@media (max-width: 760px) { .lc-final { grid-template-columns: minmax(0, 1fr); } }\n.lc-para { font-size: var(--cds-font-size-body); line-height: 1.65; margin: 0; max-width: 72ch; }\n.lc-figs { display: grid; gap: var(--cds-gap-sm); }\n.lc-figs .row { display: flex; justify-content: space-between; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); border-bottom: 1px solid var(--color-border-line); padding-bottom: 6px; }\n.lc-figs .row span:first-child { color: var(--color-fg-muted); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.lc-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 120px; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.lc-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n</style>\n\n<div class=\"lc\">\n  <header class=\"lc-head\" id=\"top\">\n    <h1>Lula's runoff comeback</h1>\n    <p class=\"lc-take\">Lula turned a <b class=\"dash-skeleton\" data-source=\"national\" data-field=\"gap1\" data-where=\"name=Brazil\">—</b>-vote first-round deficit into a <b class=\"dash-skeleton\" data-source=\"national\" data-field=\"gap2\" data-where=\"name=Brazil\">—</b>-vote runoff win, a turnaround of <b class=\"dash-skeleton\" data-source=\"national\" data-field=\"turnaround\" data-where=\"name=Brazil\">—</b> votes. Runoff count: <b class=\"dash-skeleton\" data-source=\"national\" data-field=\"counted2\" data-where=\"name=Brazil\">—</b> of sections.</p>\n  </header>\n\n  <div class=\"lc-tiles\" id=\"headline\">\n    <div class=\"lc-tile\"><span class=\"k\">Lula, runoff</span><span class=\"v dash-skeleton\" data-source=\"national\" data-field=\"lula_2\" data-where=\"name=Brazil\">—</span><span class=\"d\">of valid votes · <span data-source=\"national\" data-field=\"lula_2022\" data-where=\"name=Brazil\">—</span> in the 2022 runoff</span></div>\n    <div class=\"lc-tile\"><span class=\"k\">Lula, 1st round (vs Flávio only)</span><span class=\"v dash-skeleton\" data-source=\"national\" data-field=\"lula_2way_1\" data-where=\"name=Brazil\">—</span><span class=\"d\">counting only Lula and Flávio Bolsonaro votes</span></div>\n    <div class=\"lc-tile\"><span class=\"k\">Turnout change</span><span class=\"v dash-skeleton\" data-source=\"national\" data-field=\"turnout_change\" data-where=\"name=Brazil\">—</span><span class=\"d\"><span data-source=\"national\" data-field=\"turnout1\" data-where=\"name=Brazil\">—</span> in the 1st round, <span data-source=\"national\" data-field=\"turnout2\" data-where=\"name=Brazil\">—</span> in the runoff</span></div>\n    <div class=\"lc-tile\"><span class=\"k\">Other candidates' voters who chose Lula</span><span class=\"v dash-skeleton\" data-source=\"national\" data-field=\"others_to_lula\" data-where=\"name=Brazil\">—</span><span class=\"d\">estimated, of the <span data-source=\"national\" data-field=\"others_voters\" data-where=\"name=Brazil\">—</span> first-round voters for other candidates, among those who picked a side</span></div>\n  </div>\n\n  <section class=\"lc-sec\" id=\"bridge-sec\">\n    <h2>Where the turnaround came from</h2>\n    <div class=\"lc-card\">\n      <h3 id=\"bridge-title\">From a first-round deficit to a runoff win, in votes</h3>\n      <p class=\"lc-note\">Each bar is one group of first-round voters and how much it moved the Lula-minus-Flávio gap. The first and last bars are counted results. The bars between are estimated by fitting each state’s municipal results (ecological regression), so read them as approximate: they show where gains happened, not which individuals switched.</p>\n      <div class=\"lc-chart\" id=\"bridge\" data-source=\"bridge\"></div>\n    </div>\n  </section>\n\n  <section class=\"lc-sec\" id=\"transfers-sec\">\n    <h2>Where each first-round group went</h2>\n    <div class=\"lc-card\">\n      <h3>Estimated runoff choice of each first-round group</h3>\n      <p class=\"lc-note\">Share of each group's voters who voted Lula, Flávio Bolsonaro, blank or null, or stayed home in the runoff. Estimated by fitting runoff results in every municipality as a mix of first-round results; hover for the range across three fits (state by state, region by region, national).</p>\n      <div class=\"lc-chart\" id=\"transfers\" data-source=\"transfers\" style=\"min-height:300px\"></div>\n      <div class=\"lc-legend\" id=\"transfers-legend\" data-source=\"transfers\"></div>\n    </div>\n  </section>\n\n  <section class=\"lc-sec\" id=\"regions-sec\">\n    <h2>Regional gains</h2>\n    <div class=\"lc-grid\">\n      <div class=\"lc-card\">\n        <h3>Shift toward Lula since the 1st round, by region</h3>\n        <p class=\"lc-note\">Change in Lula's share of the two-candidate vote, in points, from the first round (Lula and Flávio votes only) to the runoff.</p>\n        <div class=\"lc-chart\" id=\"regions-chart\" data-source=\"regions\" style=\"min-height:220px\"></div>\n      </div>\n      <div class=\"lc-card\">\n        <h3>Votes gained in each region</h3>\n        <p class=\"lc-note\">Runoff votes minus first-round votes for each candidate, and turnout change.</p>\n        <div class=\"lc-tablewrap\">\n          <table id=\"regions-table\" data-source=\"regions\" data-row-key=\"name\">\n            <thead><tr><th data-field=\"name\">Region</th><th data-field=\"lula_2way_1\">Lula 1st (2-way)</th><th data-field=\"lula_2\">Lula runoff</th><th data-field=\"lula_gain\">Lula gain</th><th data-field=\"flavio_gain\">Flávio gain</th><th data-field=\"net_lula\">Net for Lula</th><th data-field=\"turnout_change\">Turnout chg</th><th data-field=\"others_to_lula\">Others → Lula</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"lc-sec\" id=\"states-sec\">\n    <h2>State by state</h2>\n    <div class=\"lc-card\">\n      <div style=\"display:flex;flex-wrap:wrap;justify-content:space-between;gap:var(--cds-gap-sm);align-items:center\">\n        <h3 id=\"map-title\">Shift toward Lula since the 1st round</h3>\n        <div class=\"lc-seg\" id=\"map-mode\"><button data-m=\"shift\" aria-pressed=\"true\">vs 1st round</button><button data-m=\"vs_2022\" aria-pressed=\"false\">vs 2022 runoff</button><button data-m=\"net_lula\" aria-pressed=\"false\">Net votes for Lula</button></div>\n      </div>\n      <p class=\"lc-note\" id=\"map-note\"></p>\n      <div class=\"lc-grid\">\n        <div class=\"lc-chart\" id=\"map\" data-source=\"states br_states\" style=\"min-height:340px\"></div>\n        <div class=\"lc-tablewrap\" style=\"max-height:420px;overflow:auto\">\n          <table id=\"states-table\" data-source=\"states\" data-row-key=\"name\">\n            <thead><tr><th data-field=\"name\">State</th><th data-field=\"lula_2way_1\">Lula 1st (2-way)</th><th data-field=\"lula_2\">Lula runoff</th><th data-field=\"shift\">Shift</th><th data-field=\"vs_2022\">vs 2022</th><th data-field=\"net_lula\">Net for Lula</th><th data-field=\"turnout_change\">Turnout chg</th></tr></thead>\n            <tbody></tbody>\n          </table>\n        </div>\n      </div>\n      <div class=\"lc-legend\" id=\"map-legend\" data-source=\"states\"></div>\n    </div>\n  </section>\n\n  <section class=\"lc-sec\" id=\"munis-sec\">\n    <h2>Municipalities</h2>\n    <div class=\"lc-grid\">\n      <div class=\"lc-card\">\n        <h3>Where other candidates did well, Lula gained more</h3>\n        <p class=\"lc-note\">Each dot is a municipality: first-round share of valid votes for candidates other than Lula and Flávio, against the runoff shift toward Lula. Dot size follows the electorate; the line is the electorate-weighted fit.</p>\n        <div class=\"lc-chart\" id=\"scatter\" data-source=\"municipalities\" style=\"min-height:320px\"></div>\n        <div class=\"lc-legend\" id=\"scatter-legend\" data-source=\"municipalities\"></div>\n      </div>\n      <div class=\"lc-card\">\n        <h3>Turnout rose most where Lula gained most</h3>\n        <p class=\"lc-note\">Turnout change from the first round to the runoff against the shift toward Lula, by state. Bubble size follows the electorate.</p>\n        <div class=\"lc-chart\" id=\"turnout\" data-source=\"states\" style=\"min-height:320px\"></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"lc-sec\" id=\"summary\">\n    <h2>What drove the comeback</h2>\n    <div class=\"lc-final\">\n      <p class=\"lc-para\" id=\"para\">Lula’s comeback was won mostly on ballots that were not cast for either finalist in the first round, more than on converts. Between the two rounds he gained <b data-source=\"national\" data-field=\"lula_gain\" data-where=\"name=Brazil\">—</b> votes to Flávio Bolsonaro’s <b data-source=\"national\" data-field=\"flavio_gain\" data-where=\"name=Brazil\">—</b>, turning a <b data-source=\"national\" data-field=\"gap1\" data-where=\"name=Brazil\">—</b>-vote deficit into a <b data-source=\"national\" data-field=\"gap2\" data-where=\"name=Brazil\">—</b>-vote lead. That is the first time since runoffs began in 1989 that the first-round runner-up has won. The <b data-source=\"national\" data-field=\"pool\" data-where=\"name=Brazil\">—</b> extra votes for the two finalists had three sources: the <b data-source=\"national\" data-field=\"others_voters\" data-where=\"name=Brazil\">—</b> first-round voters for other candidates, <b data-source=\"national\" data-field=\"bn_drop\" data-where=\"name=Brazil\">—</b> fewer blank or null ballots, and <b data-source=\"national\" data-field=\"extra_voters\" data-where=\"name=Brazil\">—</b> more voters as turnout rose from <b data-source=\"national\" data-field=\"turnout1\" data-where=\"name=Brazil\">—</b> to <b data-source=\"national\" data-field=\"turnout2\" data-where=\"name=Brazil\">—</b>. Lula took <b data-source=\"national\" data-field=\"lula_share_pool\" data-where=\"name=Brazil\">—</b> of that pool. Other candidates’ voters leaned only modestly his way: an estimated <b data-source=\"national\" data-field=\"others_to_lula\" data-where=\"name=Brazil\">—</b> of those who picked a side chose Lula (<b data-source=\"national\" data-field=\"others_to_lula_lo\" data-where=\"name=Brazil\">—</b> to <b data-source=\"national\" data-field=\"others_to_lula_hi\" data-where=\"name=Brazil\">—</b> depending on how the model is fitted), worth about <b data-source=\"national\" data-field=\"others_net_lula\" data-where=\"name=Brazil\">—</b> net votes. The bigger part of his advantage, roughly <b data-source=\"national\" data-field=\"new_net_lula\" data-where=\"name=Brazil\">—</b> net, came from places where first-round blank or null voters and non-voters turned out for him, although municipal data shows where this happened rather than which individuals switched. The swing was broad, with Lula improving in <b data-source=\"national\" data-field=\"munis_toward_lula\" data-where=\"name=Brazil\">—</b> of <b data-source=\"national\" data-field=\"munis_n\" data-where=\"name=Brazil\">—</b> municipalities, but it was largest outside his northeastern base. The Southeast alone gave him <b data-source=\"regions\" data-field=\"net_lula\" data-where=\"name=Southeast\">—</b> net votes, led by São Paulo (<b data-source=\"states\" data-field=\"net_lula\" data-where=\"name=São Paulo\">—</b>), Minas Gerais (<b data-source=\"states\" data-field=\"net_lula\" data-where=\"name=Minas Gerais\">—</b>) and Rio de Janeiro (<b data-source=\"states\" data-field=\"net_lula\" data-where=\"name=Rio de Janeiro\">—</b>, the largest shift at <b data-source=\"states\" data-field=\"shift\" data-where=\"name=Rio de Janeiro\">—</b>). The Northeast, already at <b data-source=\"regions\" data-field=\"lula_2way_1\" data-where=\"name=Northeast\">—</b>, moved <b data-source=\"regions\" data-field=\"shift\" data-where=\"name=Northeast\">—</b> and added <b data-source=\"regions\" data-field=\"net_lula\" data-where=\"name=Northeast\">—</b>. His final <b data-source=\"national\" data-field=\"lula_2\" data-where=\"name=Brazil\">—</b> edges his 2022 runoff share of <b data-source=\"national\" data-field=\"lula_2022\" data-where=\"name=Brazil\">—</b>, on a different map: stronger in Rio de Janeiro (<b data-source=\"states\" data-field=\"vs_2022\" data-where=\"name=Rio de Janeiro\">—</b> on 2022) and São Paulo (<b data-source=\"states\" data-field=\"vs_2022\" data-where=\"name=São Paulo\">—</b>), weaker in Bahia (<b data-source=\"states\" data-field=\"vs_2022\" data-where=\"name=Bahia\">—</b>) and Ceará (<b data-source=\"states\" data-field=\"vs_2022\" data-where=\"name=Ceará\">—</b>).</p>\n      <div class=\"lc-card lc-figs\" id=\"figs\"><h3>Key figures</h3><div class=\"row\"><span>Lula, votes gained</span><b data-source=\"national\" data-field=\"lula_gain\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Flávio Bolsonaro, votes gained</span><b data-source=\"national\" data-field=\"flavio_gain\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Extra votes for the two finalists</span><b data-source=\"national\" data-field=\"pool\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Lula’s share of them</span><b data-source=\"national\" data-field=\"lula_share_pool\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Other candidates’ voters choosing Lula (est.)</span><b data-source=\"national\" data-field=\"others_to_lula\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Net from other candidates’ voters (est.)</span><b data-source=\"national\" data-field=\"others_net_lula\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Net from 1st-round blank, null and non-voters (est.)</span><b data-source=\"national\" data-field=\"new_net_lula\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Turnout change</span><b data-source=\"national\" data-field=\"turnout_change\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Municipalities moving toward Lula</span><b data-source=\"national\" data-field=\"munis_toward_lula\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Municipalities flipped to Lula</span><b data-source=\"national\" data-field=\"munis_flipped\" data-where=\"name=Brazil\">—</b></div><div class=\"row\"><span>Southeast, net for Lula</span><b data-source=\"regions\" data-field=\"net_lula\" data-where=\"name=Southeast\">—</b></div><div class=\"row\"><span>Northeast, net for Lula</span><b data-source=\"regions\" data-field=\"net_lula\" data-where=\"name=Northeast\">—</b></div><p class=\"lc-note\">Figures marked est. come from municipal-level ecological regression; the rest are counted results.</p></div>\n    </div>\n  </section>\n</div>\n<div class=\"lc-tip\" id=\"lc-tip\" hidden></div>\n\n<script>\n(() => {\n  const fmt = d3.format(',');\n  const compact = (v) => new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(v);\n  const signedC = (v) => `${v >= 0 ? '+' : '−'}${compact(Math.abs(v))}`;\n  const signedN = (v) => `${v >= 0 ? '+' : '−'}${fmt(Math.abs(Math.round(v)))}`;\n  const pts = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)} pts`;\n  const pct = (v, d = 1) => `${v.toFixed(d)}%`;\n  const share = (v) => d3.format('.0%')(v);\n  // Resolve theme tokens to concrete colours (for interpolation and gradients).\n  const probe = document.createElement('span');\n  document.getElementById('dash-root').appendChild(probe);\n  const resolve = (c) => { probe.style.color = c; return getComputedStyle(probe).color; };\n  const tip = document.getElementById('lc-tip');\n  const showTip = (box, evt, html) => {\n    if (tip.parentElement !== box) box.appendChild(tip);\n    tip.innerHTML = html; tip.hidden = false;\n    const r = box.getBoundingClientRect();\n    let x = evt.clientX - r.left + 12; let y = evt.clientY - r.top + 12;\n    if (x + tip.offsetWidth > r.width) x = Math.max(0, evt.clientX - r.left - tip.offsetWidth - 12);\n    tip.style.left = `${x}px`; tip.style.top = `${y}px`;\n  };\n  const hideTip = () => { tip.hidden = true; };\n  const esc = (s) => String(s).replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\n  const fail = (el) => { el.innerHTML = '<div class=\"lc-fail\">Failed to load</div>'; };\n\n  // Formatting for marked single values, by field.\n  const FIELD_FMT = {\n    gap1: (v) => fmt(Math.abs(v)), gap2: (v) => fmt(Math.abs(v)), turnaround: (v) => fmt(v),\n    counted2: (v) => pct(v, 2), lula_2: (v) => pct(v, 2), lula_2022: (v) => pct(v, 2), lula_2way_1: (v) => pct(v, 2),\n    turnout_change: pts, turnout1: (v) => pct(v), turnout2: (v) => pct(v), others_to_lula: share, others_voters: compact,\n    others_net_lula: signedC, net_lula: signedC, lula_gain: signedC, flavio_gain: signedC, shift: pts, vs_2022: pts,\n    others_to_lula_lo: share, others_to_lula_hi: share, pool: compact, lula_share_pool: share, bn_drop: compact,\n    extra_voters: compact, new_net_lula: signedC, munis_toward_lula: fmt, munis_n: fmt, munis_flipped: fmt,\n  };\n  const fillMarks = (id, rows) => {\n    document.querySelectorAll(`[data-source=\"${id}\"][data-field][data-where]`).forEach((el) => {\n      const [k, v] = el.dataset.where.split('=');\n      const row = rows.find((r) => String(r[k]) === decodeURIComponent(v));\n      const f = FIELD_FMT[el.dataset.field] || ((x) => x);\n      el.textContent = row && row[el.dataset.field] != null ? f(row[el.dataset.field]) : '—';\n      el.classList.remove('dash-skeleton');\n    });\n  };\n\n  let mapMode = 'shift';\n  document.querySelectorAll('#map-mode button').forEach((b) => b.addEventListener('click', () => {\n    mapMode = b.dataset.m;\n    document.querySelectorAll('#map-mode button').forEach((x) => x.setAttribute('aria-pressed', x === b));\n    draw();\n  }));\n\n  function bridgeChart(rows) {\n    const box = document.getElementById('bridge');\n    const w = Math.max(300, box.clientWidth);\n    const lab = w < 560 ? 150 : 230;\n    const rh = 30; const h = rows.length * rh + 28;\n    const lula = resolve(dash.colors[0]); const fl = resolve(dash.colors[1]);\n    let run = 0;\n    const bars = rows.map((r) => {\n      if (r.kind === 'start') { run = r.votes; return { ...r, a: 0, b: r.votes }; }\n      if (r.kind === 'end') return { ...r, a: 0, b: r.votes };\n      const a = run; run += r.votes; return { ...r, a, b: run };\n    });\n    const ext = d3.extent(bars.flatMap((d) => [d.a, d.b, 0]));\n    const x = d3.scaleLinear(ext, [lab, w - 70]).nice();\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    svg.append('line').attr('x1', x(0)).attr('x2', x(0)).attr('y1', 0).attr('y2', h - 24).style('stroke', 'var(--cds-chart-reference)');\n    for (const t of x.ticks(w < 560 ? 4 : 6)) {\n      svg.append('text').attr('x', x(t)).attr('y', h - 6).attr('text-anchor', 'middle').text(signedC(t).replace('+0', '0').replace('−0', '0'));\n    }\n    const g = svg.selectAll('g.r').data(bars).join('g').attr('transform', (d, i) => `translate(0,${i * rh})`);\n    g.append('text').attr('class', 'lbl').attr('x', lab - 8).attr('y', rh / 2).attr('dy', '0.35em').attr('text-anchor', 'end').text((d) => d.step);\n    g.append('rect').attr('x', (d) => x(Math.min(d.a, d.b))).attr('width', (d) => Math.max(2, Math.abs(x(d.b) - x(d.a))))\n      .attr('y', 6).attr('height', rh - 12).attr('rx', 4)\n      .style('fill', (d) => (d.kind !== 'step' ? (d.b >= 0 ? lula : fl) : d.votes >= 0 ? lula : fl))\n      .style('opacity', (d) => (d.kind === 'step' ? 0.85 : 1));\n    g.append('text').attr('x', (d) => x(Math.max(d.a, d.b)) + 6).attr('y', rh / 2).attr('dy', '0.35em')\n      .text((d) => (d.kind === 'step' ? signedC(d.votes) : `${d.votes >= 0 ? 'Lula' : 'Flávio'} +${compact(Math.abs(d.votes))}`));\n    g.on('mousemove', (evt, d) => showTip(box, evt, `<div class=\"t\">${esc(d.step)}</div>${d.kind === 'step' ? `${signedN(d.votes)} votes on the Lula-minus-Flávio gap` : `${d.votes >= 0 ? 'Lula' : 'Flávio Bolsonaro'} ahead by ${fmt(Math.abs(d.votes))} votes`}`))\n      .on('mouseleave', hideTip);\n    box.replaceChildren(svg.node());\n  }\n\n  function transfersChart(rows) {\n    const box = document.getElementById('transfers');\n    const w = Math.max(300, box.clientWidth);\n    const lab = w < 560 ? 150 : 250;\n    const rh = 34; const h = rows.length * rh + 10;\n    const cols = [['to_pt', 'Lula', resolve(dash.colors[0])], ['to_pl', 'Flávio Bolsonaro', resolve(dash.colors[1])],\n      ['to_bn', 'Blank or null', resolve('var(--cds-chart-muted)')], ['to_abst', 'Did not vote', resolve('var(--color-border-line)')]];\n    const x = d3.scaleLinear([0, 1], [lab, w - 8]);\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    const g = svg.selectAll('g').data(rows).join('g').attr('transform', (d, i) => `translate(0,${i * rh})`);\n    g.append('text').attr('class', 'lbl').attr('x', lab - 8).attr('y', rh / 2 - 5).attr('dy', '0.35em').attr('text-anchor', 'end').text((d) => d.group);\n    g.append('text').attr('x', lab - 8).attr('y', rh / 2 + 9).attr('dy', '0.35em').attr('text-anchor', 'end').text((d) => `${compact(d.voters)} voters`);\n    g.each(function (d) {\n      let acc = 0;\n      for (const [k, name, c] of cols) {\n        const v = d[k];\n        d3.select(this).append('rect').attr('x', x(acc) + 1).attr('width', Math.max(0, x(acc + v) - x(acc) - 2)).attr('y', 6).attr('height', rh - 12).attr('rx', 3).style('fill', c);\n        if (v >= 0.09) d3.select(this).append('text').attr('x', x(acc + v / 2)).attr('y', rh / 2).attr('dy', '0.35em').attr('text-anchor', 'middle')\n          .style('fill', k === 'to_abst' ? 'var(--color-fg)' : '#fff').text(share(v));\n        acc += v;\n      }\n    });\n    g.on('mousemove', (evt, d) => showTip(box, evt, `<div class=\"t\">${esc(d.group)} · ${fmt(d.voters)}</div>` + cols.map(([k, name]) =>\n      `${esc(name)}: <b>${share(d[k])}</b> <span style=\"color:var(--cds-text-secondary)\">(${share(d[`${k}_lo`])}–${share(d[`${k}_hi`])})</span>`).join('<br>')))\n      .on('mouseleave', hideTip);\n    box.replaceChildren(svg.node());\n    document.getElementById('transfers-legend').innerHTML = cols.map(([, n, c]) => `<span><i style=\"background:${c}\"></i>${esc(n)}</span>`).join('');\n  }\n\n  function regionsChart(rows) {\n    const box = document.getElementById('regions-chart');\n    const w = Math.max(300, box.clientWidth);\n    const lab = 100; const rh = 32; const h = rows.length * rh + 26;\n    const ext = d3.extent([0, ...rows.map((r) => r.shift)]);\n    const x = d3.scaleLinear(ext, [lab, w - 70]).nice();\n    const lula = resolve(dash.colors[0]); const fl = resolve(dash.colors[1]);\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    svg.append('line').attr('x1', x(0)).attr('x2', x(0)).attr('y1', 0).attr('y2', h - 22).style('stroke', 'var(--cds-chart-reference)');\n    for (const t of x.ticks(5)) svg.append('text').attr('x', x(t)).attr('y', h - 6).attr('text-anchor', 'middle').text(`${t > 0 ? '+' : ''}${t}`);\n    const g = svg.selectAll('g').data(rows).join('g').attr('transform', (d, i) => `translate(0,${i * rh})`);\n    g.append('text').attr('class', 'lbl').attr('x', lab - 8).attr('y', rh / 2).attr('dy', '0.35em').attr('text-anchor', 'end').text((d) => d.name);\n    g.append('rect').attr('x', (d) => x(Math.min(0, d.shift))).attr('width', (d) => Math.max(2, Math.abs(x(d.shift) - x(0)))).attr('y', 7).attr('height', rh - 14).attr('rx', 4)\n      .style('fill', (d) => (d.shift >= 0 ? lula : fl));\n    g.append('text').attr('x', (d) => x(Math.max(0, d.shift)) + 6).attr('y', rh / 2).attr('dy', '0.35em').text((d) => pts(d.shift));\n    g.on('mousemove', (evt, d) => showTip(box, evt, `<div class=\"t\">${esc(d.name)}</div>Lula ${pct(d.lula_2way_1)} → ${pct(d.lula_2)}<br>Net for Lula ${signedN(d.net_lula)}<br>Turnout ${pts(d.turnout_change)}`)).on('mouseleave', hideTip);\n    box.replaceChildren(svg.node());\n  }\n\n  function table(id, rows, cells) {\n    const tb = document.querySelector(`#${id} tbody`);\n    tb.innerHTML = '';\n    for (const r of rows) {\n      const tr = document.createElement('tr');\n      for (const c of cells) { const td = document.createElement('td'); td.textContent = c(r); tr.appendChild(td); }\n      tb.appendChild(tr);\n    }\n  }\n\n  function mapChart(states, geoRows) {\n    const box = document.getElementById('map');\n    const features = geoRows.map((g) => ({ type: 'Feature', properties: { ibge: String(g.ibge) }, geometry: JSON.parse(g.geometry) }));\n    const fc = { type: 'FeatureCollection', features };\n    const w = Math.max(280, box.clientWidth); const h = Math.min(w, 460);\n    const path = d3.geoPath(d3.geoIdentity().reflectY(true).fitSize([w, h], fc));\n    const byIbge = Object.fromEntries(states.filter((s) => s.ibge).map((s) => [String(s.ibge), s]));\n    const vals = states.filter((s) => s.uf !== 'zz' && s[mapMode] != null).map((s) => Math.abs(s[mapMode])).sort(d3.ascending);\n    const top = d3.quantile(vals, 0.9) || 1;\n    const lula = resolve(dash.colors[0]); const fl = resolve(dash.colors[1]); const mid = resolve('var(--color-border-line)');\n    const col = d3.scaleLinear([-top, 0, top], [fl, mid, lula]).clamp(true);\n    const label = mapMode === 'net_lula' ? (v) => signedC(v) : (v) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`;\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    svg.selectAll('path').data(features).join('path').attr('d', path)\n      .style('fill', (d) => { const s = byIbge[d.properties.ibge]; return s && s[mapMode] != null ? col(s[mapMode]) : 'var(--cds-chart-muted)'; })\n      .style('stroke', 'var(--color-panel)').style('stroke-width', 1)\n      .on('mousemove', (evt, d) => { const s = byIbge[d.properties.ibge]; if (s) showTip(box, evt, `<div class=\"t\">${esc(s.name)}</div>Lula ${pct(s.lula_2way_1)} (1st, 2-way) → ${pct(s.lula_2)}<br>Shift ${pts(s.shift)} · vs 2022 ${s.vs_2022 != null ? pts(s.vs_2022) : '–'}<br>Net for Lula ${signedN(s.net_lula)} · turnout ${pts(s.turnout_change)}`); })\n      .on('mouseleave', hideTip);\n    svg.selectAll('text').data(features.filter((d) => path.area(d) > 900 && byIbge[d.properties.ibge])).join('text')\n      .attr('transform', (d) => `translate(${path.centroid(d)})`).attr('text-anchor', 'middle').attr('dy', '0.35em').attr('class', 'lbl')\n      .style('paint-order', 'stroke').style('stroke', 'var(--color-panel)').style('stroke-width', '3px').style('pointer-events', 'none')\n      .text((d) => `${byIbge[d.properties.ibge].uf.toUpperCase()} ${label(byIbge[d.properties.ibge][mapMode])}`);\n    box.replaceChildren(svg.node());\n    const titles = { shift: 'Shift toward Lula since the 1st round', vs_2022: 'Change against the 2022 runoff', net_lula: 'Net votes for Lula since the 1st round' };\n    const notes = {\n      shift: 'Change in Lula’s share of the two-candidate vote from the first round (Lula and Flávio votes only) to the runoff, in points.',\n      vs_2022: 'Lula’s runoff share now minus his share in the 2022 runoff against Jair Bolsonaro, in points.',\n      net_lula: 'Lula’s runoff votes gained since the first round minus Flávio Bolsonaro’s.',\n    };\n    document.getElementById('map-title').textContent = titles[mapMode];\n    document.getElementById('map-note').textContent = notes[mapMode];\n    const zz = states.find((s) => s.uf === 'zz');\n    document.getElementById('map-legend').innerHTML = `<span>toward Flávio <i class=\"ramp\" style=\"background:linear-gradient(90deg,${fl},${mid},${lula})\"></i> toward Lula</span><span>Full colour at ${mapMode === 'net_lula' ? compact(top) + ' votes' : top.toFixed(1) + ' pts'}</span>${zz && zz[mapMode] != null ? `<span>Abroad (not on map): ${label(zz[mapMode])}</span>` : ''}`;\n  }\n\n  function scatterChart(rows) {\n    const box = document.getElementById('scatter');\n    const w = Math.max(300, box.clientWidth); const h = Math.min(380, Math.max(280, w * 0.7));\n    const m = { t: 10, r: 12, b: 36, l: 44 };\n    const regions = ['North', 'Northeast', 'Centre-West', 'Southeast', 'South'];\n    const color = Object.fromEntries(regions.map((r, i) => [r, resolve(dash.colors[i + 2] || dash.colors[i])]));\n    const x = d3.scaleLinear([0, d3.quantile(rows.map((r) => r.others_share1).sort(d3.ascending), 0.995)], [m.l, w - m.r]).nice();\n    const yv = rows.map((r) => r.shift).sort(d3.ascending);\n    const y = d3.scaleLinear([d3.quantile(yv, 0.003), d3.quantile(yv, 0.997)], [h - m.b, m.t]).nice();\n    const r = d3.scaleSqrt([0, d3.max(rows, (d) => d.electorate)], [0.8, 14]);\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    for (const t of y.ticks(6)) {\n      svg.append('line').attr('x1', m.l).attr('x2', w - m.r).attr('y1', y(t)).attr('y2', y(t)).style('stroke', t === 0 ? 'var(--cds-chart-reference)' : 'var(--cds-chart-grid)');\n      svg.append('text').attr('x', m.l - 6).attr('y', y(t)).attr('dy', '0.35em').attr('text-anchor', 'end').text(`${t > 0 ? '+' : ''}${t}`);\n    }\n    for (const t of x.ticks(6)) svg.append('text').attr('x', x(t)).attr('y', h - m.b + 16).attr('text-anchor', 'middle').text(`${t}%`);\n    svg.append('text').attr('x', w - m.r).attr('y', h - 4).attr('text-anchor', 'end').text('other candidates, 1st round');\n    svg.append('text').attr('x', m.l).attr('y', m.t + 2).attr('dy', '0.7em').attr('dx', 4).text('shift toward Lula, pts');\n    const inside = rows.filter((d) => d.others_share1 <= x.domain()[1] && d.shift >= y.domain()[0] && d.shift <= y.domain()[1]).sort((a, b) => b.electorate - a.electorate);\n    svg.append('g').selectAll('circle').data(inside).join('circle')\n      .attr('cx', (d) => x(d.others_share1)).attr('cy', (d) => y(d.shift)).attr('r', (d) => r(d.electorate))\n      .style('fill', (d) => color[d.region]).style('fill-opacity', 0.45).style('stroke', (d) => color[d.region]).style('stroke-opacity', 0.7).style('stroke-width', 0.5);\n    // Electorate-weighted least-squares line.\n    const W = d3.sum(rows, (d) => d.electorate);\n    const mx = d3.sum(rows, (d) => d.electorate * d.others_share1) / W;\n    const my = d3.sum(rows, (d) => d.electorate * d.shift) / W;\n    const b = d3.sum(rows, (d) => d.electorate * (d.others_share1 - mx) * (d.shift - my)) / d3.sum(rows, (d) => d.electorate * (d.others_share1 - mx) ** 2);\n    const [x0, x1] = x.domain();\n    svg.append('line').attr('x1', x(x0)).attr('y1', y(my + b * (x0 - mx))).attr('x2', x(x1)).attr('y2', y(my + b * (x1 - mx)))\n      .style('stroke', 'var(--color-fg)').style('stroke-width', 2).style('stroke-linecap', 'round');\n    const delaunay = d3.Delaunay.from(inside, (d) => x(d.others_share1), (d) => y(d.shift));\n    svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', w - m.l - m.r).attr('height', h - m.t - m.b).style('fill', 'transparent')\n      .on('mousemove', (evt) => {\n        const [px, py] = d3.pointer(evt); const d = inside[delaunay.find(px, py)];\n        if (d) showTip(box, evt, `<div class=\"t\">${esc(d.name)} (${esc(d.uf)})</div>Other candidates ${pct(d.others_share1)}<br>Lula ${pct(d.lula_2way_1)} → ${pct(d.lula_2)} (${pts(d.shift)})<br>${fmt(d.electorate)} voters`);\n      })\n      .on('mouseleave', hideTip);\n    box.replaceChildren(svg.node());\n    document.getElementById('scatter-legend').innerHTML = regions.map((rg) => `<span><i style=\"background:${color[rg]}\"></i>${rg}</span>`).join('') + `<span>Slope: ${b >= 0 ? '+' : '−'}${Math.abs(b).toFixed(2)} pts of shift per point of other-candidate vote</span>`;\n  }\n\n  function turnoutChart(states) {\n    const box = document.getElementById('turnout');\n    const rows = states.filter((s) => s.uf !== 'zz');\n    const w = Math.max(300, box.clientWidth); const h = Math.min(360, Math.max(280, w * 0.7));\n    const m = { t: 10, r: 14, b: 36, l: 44 };\n    const x = d3.scaleLinear(d3.extent(rows, (d) => d.turnout_change), [m.l, w - m.r]).nice();\n    const y = d3.scaleLinear(d3.extent([0, ...rows.map((d) => d.shift)]), [h - m.b, m.t]).nice();\n    const r = d3.scaleSqrt([0, d3.max(rows, (d) => d.electorate)], [3, 22]);\n    const lula = resolve(dash.colors[0]);\n    const svg = d3.create('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n    for (const t of y.ticks(5)) {\n      svg.append('line').attr('x1', m.l).attr('x2', w - m.r).attr('y1', y(t)).attr('y2', y(t)).style('stroke', t === 0 ? 'var(--cds-chart-reference)' : 'var(--cds-chart-grid)');\n      svg.append('text').attr('x', m.l - 6).attr('y', y(t)).attr('dy', '0.35em').attr('text-anchor', 'end').text(`${t > 0 ? '+' : ''}${t}`);\n    }\n    for (const t of x.ticks(5)) svg.append('text').attr('x', x(t)).attr('y', h - m.b + 16).attr('text-anchor', 'middle').text(`${t > 0 ? '+' : ''}${t}`);\n    svg.append('text').attr('x', w - m.r).attr('y', h - 4).attr('text-anchor', 'end').text('turnout change, pts');\n    svg.append('text').attr('x', m.l).attr('y', m.t + 2).attr('dy', '0.7em').attr('dx', 4).text('shift toward Lula, pts');\n    const g = svg.selectAll('g.s').data(rows.sort((a, b) => b.electorate - a.electorate)).join('g');\n    g.append('circle').attr('cx', (d) => x(d.turnout_change)).attr('cy', (d) => y(d.shift)).attr('r', (d) => r(d.electorate))\n      .style('fill', lula).style('fill-opacity', 0.35).style('stroke', lula).style('stroke-width', 1);\n    g.append('text').attr('class', 'lbl').attr('x', (d) => x(d.turnout_change)).attr('y', (d) => y(d.shift)).attr('dy', '0.35em').attr('text-anchor', 'middle')\n      .style('pointer-events', 'none').text((d) => (r(d.electorate) > 9 ? d.uf.toUpperCase() : ''));\n    g.on('mousemove', (evt, d) => showTip(box, evt, `<div class=\"t\">${esc(d.name)}</div>Turnout ${pct(d.turnout1)} → ${pct(d.turnout2)} (${pts(d.turnout_change)})<br>Shift toward Lula ${pts(d.shift)}`)).on('mouseleave', hideTip);\n    box.replaceChildren(svg.node());\n  }\n\n  function draw() {\n    const nat = dash.data('national'); const br = dash.data('bridge'); const tr = dash.data('transfers');\n    const rg = dash.data('regions'); const st = dash.data('states'); const mu = dash.data('municipalities'); const geo = dash.data('br_states');\n    if (nat.status === 'ok') fillMarks('national', nat.data);\n    if (rg.status === 'ok') fillMarks('regions', rg.data);\n    if (st.status === 'ok') fillMarks('states', st.data);\n    if (tr.status === 'ok') fillMarks('transfers', tr.data);\n    if (br.status === 'ok') bridgeChart(br.data); else if (br.status === 'error') fail(document.getElementById('bridge'));\n    if (tr.status === 'ok') transfersChart(tr.data); else if (tr.status === 'error') fail(document.getElementById('transfers'));\n    if (rg.status === 'ok') {\n      regionsChart(rg.data);\n      table('regions-table', rg.data, [(r) => r.name, (r) => pct(r.lula_2way_1), (r) => pct(r.lula_2), (r) => signedC(r.lula_gain), (r) => signedC(r.flavio_gain), (r) => signedC(r.net_lula), (r) => pts(r.turnout_change), (r) => (r.others_to_lula != null ? share(r.others_to_lula) : '–')]);\n    } else if (rg.status === 'error') fail(document.getElementById('regions-chart'));\n    if (st.status === 'ok') {\n      const sorted = [...st.data].sort((a, b) => b.shift - a.shift);\n      table('states-table', sorted, [(r) => r.name, (r) => pct(r.lula_2way_1), (r) => pct(r.lula_2), (r) => pts(r.shift), (r) => (r.vs_2022 != null ? pts(r.vs_2022) : '–'), (r) => signedC(r.net_lula), (r) => pts(r.turnout_change)]);\n      turnoutChart(st.data);\n      if (geo.status === 'ok') mapChart(st.data, geo.data);\n    } else if (st.status === 'error') fail(document.getElementById('map'));\n    if (geo.status === 'error') fail(document.getElementById('map'));\n    if (mu.status === 'ok') scatterChart(mu.data); else if (mu.status === 'error') fail(document.getElementById('scatter'));\n  }\n  dash.onData(draw);\n})();\n</script>\n"}